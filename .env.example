# Copy to .env for local runs:  cp .env.example .env
# Never commit the real .env - it is git-ignored.

APP_ENV=development
LOG_LEVEL=INFO

# SQLite locally; in production use Postgres, e.g.
# postgresql+psycopg://expense:secret@db:5432/expenses
DATABASE_URL=sqlite:///expenses.db

# Injected automatically by CI/CD from ${{ github.sha }} - do not hardcode.
GIT_SHA=dev
